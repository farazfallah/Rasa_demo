# نسخه اپ؛ با ./update-demo.sh خودکار تنظیم می‌شود
APP_VERSION=1.0.0
# مخزن نسخه‌های اپ (برای update-demo.sh)
APP_REPO=farazfallah/school_app

# دامنه سایت معرفی (فرم درخواست دمو و پنل /panel) و دامنه نسخه نمایشی
SITE_DOMAIN=rasa.example.com
DEMO_DOMAIN=demo.rasa.example.com

# رمزها: مقادیر طولانی و تصادفی بگذارید (مثلا: openssl rand -base64 32)
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# رمز حساب admin اپ نمایشی (فقط برای شما؛ به متقاضیان داده نمی‌شود)
DEMO_ROOT_PASSWORD=
# ورود به پنل درخواست‌ها
PANEL_USER=admin
PANEL_PASSWORD=

# ساعت بازسازی شبانه (به وقت تهران) و مدت پیش‌فرض دسترسی متقاضی (روز)
RESET_AT=03:30
LEAD_DAYS=7

# اختیاری: پرداخت آنلاین آزمایشی با sandbox زرین‌پال (شناسه پذیرنده ۳۶ کاراکتری)
# خالی = بدون درگاه آنلاین (درگاه آزمایشی خود اپ در نسخه production غیرفعال است)
ZARINPAL_SANDBOX_MERCHANT=
