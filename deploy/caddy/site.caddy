# سایت معرفی: فرم درخواست، پنل و صفحه‌های ثابت
# zstd نه: برخی CDN ها (مثل آروان) آن را درست پاس نمی‌دهند و صفحه سفید می‌شود
encode gzip

# فرم درخواست دمو و پنل مدیریت درخواست‌ها
handle /api/demo-requests {
	reverse_proxy kit:8090
}
handle /panel* {
	reverse_proxy kit:8090
}
# فایل‌های راهنمای سامانه (بارگذاری از پنل، دانلود در صفحه «راهنمای کامل»)
handle /api/docs {
	reverse_proxy kit:8090
}
handle /docs/* {
	reverse_proxy kit:8090
}

# صفحه‌ها با نشانی بدون .html (مثلا /features/timetable)؛ نشانی‌های قدیمی و با / پایانی به نشانی اصلی می‌روند
handle {
	root * /srv/site
	redir /index.html / 301
	@html path_regexp html ^(/.+)\.html$
	redir @html {re.html.1} 301
	@slash path_regexp slash ^(/.+)/$
	redir @slash {re.slash.1} 301
	# پوشه منبع سایت (قالب‌ها، اسکریپت ساخت و متن Markdown مقاله‌ها) منتشر نمی‌شود
	# Robots.txt با R بزرگ هم همان فایل robots.txt را برمی‌گرداند
	rewrite /Robots.txt /robots.txt
	respond /src/* 404
	respond /content/* 404
	respond /CONTENT.md 404
	try_files {path} {path}.html
	# دامنه سایت در canonical، sitemap و robots از درخواست پر می‌شود ({{.Host}})
	templates {
		mime text/html text/xml application/xml text/plain
	}
	header /assets/* Cache-Control "public, max-age=86400"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=600"
	header X-Content-Type-Options nosniff
	file_server
}

handle_errors {
	@notfound expression {err.status_code} == 404
	handle @notfound {
		root * /srv/site
		rewrite * /404.html
		templates
		file_server
	}
}
