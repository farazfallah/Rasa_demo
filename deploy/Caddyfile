# دو دامنه: سایت معرفی (با فرم درخواست و پنل) و نسخه نمایشی اپ
#
# بدون CDN: گواهی HTTPS خودکار گرفته می‌شود؛ دامنه‌ها باید مستقیم به IP همین سرور اشاره کنند.
# پشت CDN (مثلا ابر آروان): در .env بگذارید SITE_SCHEME=http:// تا Caddy فقط HTTP روی پورت ۸۰ سرو کند
# و HTTPS را CDN بدهد؛ TRUSTED_PROXIES هم IP واقعی بازدیدکننده را از هدر CDN می‌خواند.

{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

{$SITE_SCHEME}{$SITE_DOMAIN} {
	# zstd نه: برخی CDN ها (مثل آروان) آن را درست پاس نمی‌دهند و صفحه سفید می‌شود
	encode gzip

	# فرم درخواست دمو و پنل مدیریت درخواست‌ها
	handle /api/demo-requests {
		reverse_proxy kit:8090
	}
	handle /panel* {
		reverse_proxy kit:8090
	}

	handle {
		root * /srv/site
		header /assets/* Cache-Control "public, max-age=86400"
		header /fonts/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

{$SITE_SCHEME}{$DEMO_DOMAIN} {
	# zstd نه: برخی CDN ها (مثل آروان) آن را درست پاس نمی‌دهند و صفحه سفید می‌شود
	encode gzip

	# هنگام بازسازی شبانه
	@maintenance file {
		root /state
		try_files /maintenance
	}
	handle @maintenance {
		root * /srv/maintenance
		rewrite * /index.html
		file_server {
			status 503
		}
	}

	# در نسخه نمایشی رمز و مشخصات حساب تغییر نمی‌کند (حساب‌ها مشترک نیستند ولی هر شب از نو ساخته می‌شوند)
	@blocked {
		method PATCH
		path /api/auth/password /api/auth/profile
	}
	handle @blocked {
		header Content-Type "application/json; charset=utf-8"
		respond `{"statusCode":403,"message":"این کار در نسخه نمایشی غیرفعال است"}` 403
	}

	handle {
		reverse_proxy web:80
	}
}
