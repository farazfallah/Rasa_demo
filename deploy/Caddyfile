# دو دامنه: سایت معرفی (با فرم درخواست و پنل) و نسخه نمایشی اپ
# گواهی HTTPS خودکار گرفته می‌شود؛ دامنه‌ها باید مستقیم به IP همین سرور اشاره کنند.
# پشت CDN (مثلا ابر آروان) به‌جای این فایل Caddyfile.cdn به کار می‌رود (CADDYFILE=Caddyfile.cdn در .env).

{$SITE_DOMAIN} {
	import parts/site.caddy
}

{$DEMO_DOMAIN} {
	import parts/demo.caddy
}
